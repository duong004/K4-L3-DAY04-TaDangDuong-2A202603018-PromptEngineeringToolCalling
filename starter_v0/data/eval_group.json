      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Máy tính mình không vào được mạng, IT kiểm tra giúp."
        },
        {
          "role": "user",
          "content": "Mã tài sản của mình là LT-240."
        },
        {
          "role": "user",
          "content": "Chỉ kiểm tra phần network trên đúng máy đó thôi."
        }
      ],
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-240",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_asset_clarification",
        "difficulty": "medium",
        "what_it_tests": "Thu thập mã máy sau khi làm rõ và trích xuất đúng tham số check network."
      }
    },
    {
      "id": "G08_multiturn_ticket_reconfirm",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
