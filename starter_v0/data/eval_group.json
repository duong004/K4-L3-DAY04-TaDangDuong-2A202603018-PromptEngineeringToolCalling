        },
        {
          "role": "user",
          "content": "À đổi sang dịch vụ wifi giúp mình."
        },
        {
          "role": "user",
          "content": "Vẫn giữ môi trường production nhé."
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "wifi",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_service_correction",
        "difficulty": "medium",
        "what_it_tests": "Kế thừa environment từ lượt trước nhưng cập nhật service mới nhất là wifi."
      }
    },
    {
