      "metadata": {
        "skill": "multiturn_ticket_reconfirmation",
        "difficulty": "hard",
        "what_it_tests": "Khi thuộc tính ticket thay đổi, xác nhận cũ bị vô hiệu hóa và phải clarify xin xác nhận lại."
      }
    },
    {
      "id": "G09_multiturn_cancel_ticket",
      "phase": "B",
      "suite": "group",
      "turns": [
