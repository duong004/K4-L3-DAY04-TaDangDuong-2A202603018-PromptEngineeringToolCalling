{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Original 10 IT helpdesk evaluation cases authored by the team: 5 single-turn and 5 multi-turn cases.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_policy_routing",
      "phase": "B",
      "suite": "group",
      "query": "Tra cứu chính sách IT nội bộ về việc sử dụng công cụ bên ngoài (external tools).",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "external_tools"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_policy_inquiry",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu tra cứu chính sách công ty phải route vào policy tool với đúng policy_area."
      }
    },
    {
      "id": "G02_service_sso_staging",
      "phase": "B",
      "suite": "group",
      "query": "Dịch vụ SSO trên môi trường staging hiện tại có hoạt động bình thường không?",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "sso",
              "environment": "staging"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_service_with_environment",
        "difficulty": "easy",
        "what_it_tests": "Kiểm tra đúng dịch vụ sso và giữ chính xác environment staging."
      }
    },
    {
      "id": "G03_missing_asset_hardware",
      "phase": "B",
      "suite": "group",
      "query": "Bàn phím máy tính của mình bị liệt phím cách, nhờ IT kiểm tra phần cứng giúp.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_missing_asset_id",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu chẩn đoán thiết bị nhưng thiếu mã tài sản phải dừng lại clarify hỏi asset ID."
      }
    },
    {
      "id": "G04_out_of_scope_weather",
      "phase": "B",
      "suite": "group",
      "query": "Thời tiết hôm nay ở Hà Nội có mưa không bạn?",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope_rejection",
        "difficulty": "easy",
        "what_it_tests": "Câu hỏi thời tiết hoàn toàn ngoài phạm vi IT Helpdesk phải từ chối mà không gọi công cụ."
      }
    },
    {
      "id": "G05_parallel_user_and_status",
      "phase": "B",
      "suite": "group",
      "query": "Tra cứu thông tin tài khoản nhân viên EMP-1002 và kiểm tra trạng thái dịch vụ email production.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_user",
            "args": {
              "employee_id": "EMP-1002"
            }
          },
          {
            "name": "check_service_status",
            "args": {
              "service": "email",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "parallel_user_and_status",
        "difficulty": "hard",
        "what_it_tests": "Thực hiện đồng thời hai công cụ độc lập lookup_user và check_service_status."
      }
    },
    {
      "id": "G06_multiturn_service_correction",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
