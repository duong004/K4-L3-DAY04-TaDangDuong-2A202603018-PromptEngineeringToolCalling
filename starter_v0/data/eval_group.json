        },
        {
          "role": "user",
          "content": "Đổi mức ưu tiên thành high giúp mình."
        },
        {
          "role": "user",
          "content": "Hãy cho mình xem lại thông tin và hỏi xác nhận trước khi tạo."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
